{
  "name": "break-the-wall",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Take material apart into source-linked parts, run the mechanism, and reassemble it.",
  "author": "Simone Riggi",
  "repository": { "type": "git", "url": "https://github.com/simoneriggi92/BreakTheWall.git" },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10.9.8 <11"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run typecheck && vite build && node scripts/build-desktop.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "eval": "node scripts/eval.mjs"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "markdown-it": "15.0.3",
    "mermaid": "12.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
