{
  "modules": ["./register.ts"],
  "hooks": {
    "UserPromptExpansion": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.mjs\"", "timeout": 10 }] }],
    "PreToolUse": [{ "matcher": "Skill", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.mjs\"", "timeout": 10 }] }],
    "SessionStart": [{ "matcher": "compact", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.mjs\"", "timeout": 10 }] }]
  }
}
